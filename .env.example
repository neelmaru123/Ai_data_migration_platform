# Application
PROJECT_NAME="AI Data Migration Platform"
ENVIRONMENT="development"
LOG_LEVEL="INFO"
SECRET_KEY="change_this_to_a_secure_random_string_in_production"

# API Service
API_HOST="0.0.0.0"
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Next.js Web Client
NEXT_PUBLIC_API_URL="http://localhost:8000"

# Application Database (PostgreSQL Metadata Store)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="migration_platform"
POSTGRES_HOST="postgres"
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://postgres:postgres_password@postgres:5432/migration_platform"

# Task Queue & Cache (Redis)
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_URL="redis://redis:6379/0"

# AI Reasoning Engine (Gemini)
GEMINI_API_KEY="your_gemini_api_key_here"
AI_PROVIDER="gemini"
AI_MODEL_NAME="gemini-1.5-pro"

# Execution Policy Defaults
MAX_CLOUD_ROWS=500000
MAX_CLOUD_SIZE_MB=100
